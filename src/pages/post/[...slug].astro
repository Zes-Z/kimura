---
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../siteconfig';
export async function getStaticPaths(){ return (await getCollection('posts')).map(entry=>({ params:{slug:entry.id}, props:{entry} })); }
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{entry.data.title} — {siteConfig.displayName}</title><link rel="stylesheet" href="/style.css"/></head><body class="article-page"><a class="article-return" href="/#notes" aria-label="返回首页">←</a><main class="article-shell"><div class="article-kicker">{entry.data.label || 'FIELD NOTE'} / {entry.data.date.toLocaleDateString('zh-CN')}</div><h1>{entry.data.title}</h1><p class="article-description">{entry.data.description}</p><img class="article-cover" src={entry.data.cover} alt={entry.data.title}/><article class="prose"><Content/></article><a class="article-back" href="/#notes">← 返回首页</a></main></body></html>
