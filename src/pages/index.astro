---
import { getCollection } from 'astro:content';
import { siteConfig as site } from '../siteconfig';
import Icon from '../components/Icon.astro';
import photos from '../content/picture/photometa.json';
const projects = (await getCollection('projects')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const posts = (await getCollection('posts')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const projectCards = projects;
const noteCards = posts;
const noteFrames = ['stamp', 'camera', 'polaroid', 'ticket', 'folio'];
---
<html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#edf1e9"/><meta name="description" content={`${site.displayName} 的个人博客：经历、影像与随想。`}/><title>{site.displayName} — Personal archive</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600&display=swap" rel="stylesheet"/><link rel="stylesheet" href="/style.css"/><link rel="stylesheet" href="/chapter-motion.css"/><script is:inline>
  if ((!location.hash || location.hash === '#top') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    try {
      if (!sessionStorage.getItem('kimura-intro-seen')) {
        sessionStorage.setItem('kimura-intro-seen', '1');
        document.documentElement.classList.add('hero-intro');
      }
    } catch {
      // A blocked storage preference leaves the hero in its readable state.
    }
  }
</script></head><body>
<div class="grain" aria-hidden="true"></div>
<div class="floating-profile" id="floating-profile">
  <button class="floating-trigger" type="button" aria-label="打开个人链接" aria-expanded="false" aria-controls="floating-menu">
    <img src={site.avatar} alt="" />
    <span class="floating-name">{site.displayName}</span><span class="floating-plus" aria-hidden="true">+</span>
  </button>
  <div class="floating-menu" id="floating-menu" aria-hidden="true" inert>
    {site.socials.map(social => <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label} title={social.label}><Icon name={social.icon} size={19} /></a>)}
    <a href={`mailto:${site.email}`} aria-label="邮箱" title="邮箱"><Icon name="mailcolor" size={19} /></a>
    {site.resume && <a href={site.resume} target="_blank" rel="noopener noreferrer" aria-label="简历" title="简历"><Icon name="cv" size={19} /></a>}
  </div>
</div>
<main id="top">
<section class="hero" style={`--hero-ratio:${site.heroImageRatio}`}><div class="hero-art"><div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div><div class="hero-planet" aria-hidden="true"><svg class="planet-ring planet-ring-back" viewBox="0 0 700 240" preserveAspectRatio="none" fill="none"><ellipse fill="none" class="ring-haze" cx="350" cy="120" rx="322" ry="88"/><ellipse fill="none" class="ring-shadow" cx="350" cy="124" rx="321" ry="88"/><ellipse fill="none" class="ring-bed" cx="350" cy="120" rx="322" ry="88"/><ellipse fill="none" class="ring-seam" cx="350" cy="120" rx="306" ry="80"/><ellipse fill="none" class="ring-edge" cx="350" cy="120" rx="317" ry="84"/><ellipse fill="none" class="ring-grains" cx="350" cy="120" rx="317" ry="84"/></svg><span class="planet-core"></span><svg class="planet-ring planet-ring-front" viewBox="0 0 700 240" preserveAspectRatio="none" fill="none"><ellipse fill="none" class="ring-haze" cx="350" cy="120" rx="322" ry="88"/><ellipse fill="none" class="ring-shadow" cx="350" cy="124" rx="321" ry="88"/><ellipse fill="none" class="ring-bed" cx="350" cy="120" rx="322" ry="88"/><ellipse fill="none" class="ring-seam" cx="350" cy="120" rx="306" ry="80"/><ellipse fill="none" class="ring-edge" cx="350" cy="120" rx="317" ry="84"/><ellipse fill="none" class="ring-grains" cx="350" cy="120" rx="317" ry="84"/></svg></div><span class="planet-moon planet-moon-one" aria-hidden="true"></span><span class="planet-moon planet-moon-two" aria-hidden="true"></span><div class="hero-hill hill-back"></div><div class="hero-hill hill-front"></div><div class="hero-title" aria-hidden="true"><span>STAY</span><span><i>curious.</i></span></div></div><div class="hero-avatar"><img src={site.avatar} alt={`${site.displayName} 的头像`}/></div><div class="hero-info"><div class="intro-grid"><div><p class="eyebrow">HELLO, I'M</p><h1>{site.displayName}<span class="intro-period">.</span></h1><p class="identity">{site.age} 岁 <span>·</span> {site.location} <span>·</span> <a href={site.siteUrl}>{site.domain} ↗</a></p></div><div class="intro-right"><p class="motto"><span class="motto-prefix">/</span><span id="typing" data-lines={JSON.stringify(site.motto)}>{site.motto[0]}</span><span class="cursor" aria-hidden="true"></span></p><div class="hero-links">{site.socials.map(s=><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>)}<a href={`mailto:${site.email}`}>Email ↗</a>{site.resume && <a href={site.resume} target="_blank">Résumé ↗</a>}</div></div></div></div></section>
<section class="section work-section" data-chapter="work" id="work"><header class="section-heading chapter-heading">
      <p class="section-number">01 / THE JOURNEY</p>
      <h2><span class="chapter-line"><span>做过的事，</span></span><span class="chapter-line"><em>留下的痕迹。</em></span></h2>
    </header><div class="work-marquee" id="work-marquee" aria-label="横向播放的项目与经历"><div class="marquee-viewport" id="marquee-viewport"><div class="marquee-track" id="marquee-track">{[0,1].map(copy=><div class="marquee-set" aria-hidden={copy===1 ? 'true' : undefined}>{projectCards.map((project,i)=><a class="marquee-card" href={`/project/${project.id}/`} tabindex={copy===1 ? -1 : undefined} style={`--card-color:${project.data.color}`}><div class="marquee-image"><img src={project.data.cover} alt={project.data.title} draggable="false" loading="lazy"/><span class="marquee-open">↗</span></div><div class="marquee-caption"><span>0{i+1} / {project.data.kind} / {project.data.year}</span><h3>{project.data.title}</h3><p>{project.data.description}</p></div></a>)}</div>)}</div></div><button class="marquee-nudge marquee-nudge-prev" id="marquee-prev" type="button" aria-label="向左移动项目">←</button><button class="marquee-nudge marquee-nudge-next" id="marquee-next" type="button" aria-label="向右移动项目">→</button></div></section>
<section class="section gallery-section" data-chapter="gallery" id="gallery"><header class="section-heading chapter-heading">
      <p class="section-number">02 / THE IN-BETWEEN</p>
      <h2><span class="chapter-line"><span>生活，</span></span><span class="chapter-line"><em>在镜头之外。</em></span></h2>
    </header><div class="photo-stage" id="photo-stage"><div class="photo-stack">{photos.map((photo,i)=><button class="photo-card" style={`--offset:${i}`} data-index={i} aria-label={`查看${photo.alt}`}>{photo.type === "video" ? <video src={photo.src} aria-label={photo.alt} playsinline muted loop preload="metadata"></video> : <img src={photo.src} alt={photo.alt} loading="lazy"/>}<span>{photo.caption}</span></button>)}</div><div class="gallery-side"><span class="gallery-count"><b id="photo-current">01</b> / {String(photos.length).padStart(2,'0')}</span><p>一页一页翻过日常。<br/>点击照片，或使用两侧按钮。</p><div class="gallery-controls"><button id="photo-prev" aria-label="上一张照片">←</button><button id="photo-next" aria-label="下一张照片">→</button></div></div></div></section>
<section class="section notes-section" data-chapter="notes" id="notes"><header class="section-heading chapter-heading">
      <p class="section-number">03 / MARGIN NOTES</p>
      <h2><span class="chapter-line"><span>偶尔，</span></span><span class="chapter-line"><em>把思绪写下来。</em></span></h2>
    </header><div class="notes-grid">{noteCards.map(post=><a class={`note-card in-view frame-${noteFrames.indexOf(post.data.frame)}`} href={`/post/${post.id}/`}><div class="note-art"><img src={post.data.cover} alt={post.data.title} loading="lazy"/></div><div class="note-meta"><span>{post.data.label || 'FIELD NOTE'} / {post.data.date.getFullYear()}</span><span>↗</span></div><h3>{post.data.title}</h3><p>{post.data.description}</p></a>)}</div></section>
<section class="closing" id="about" data-chapter="about">
  <div class="closing-panel">
    <p class="closing-kicker">04 / BEYOND THE PAGE</p>
    <div class="closing-content">
      <h2><span class="chapter-line"><span>想说的话，</span></span><span class="chapter-line"><em>都欢迎。</em></span></h2>
      <p>分享一个想法，或只是打声招呼。<br/>下一段故事，就从这里开始。</p>
      <div class="closing-actions">
        <a class="contact-link" href={`mailto:${site.email}`}>写封邮件 <span aria-hidden="true">↗</span></a>
        <button class="copy-email" type="button" data-copy-email={site.email} aria-label="复制邮箱地址"><Icon name="mail" size={18} /><span class="copy-label" aria-live="polite">复制邮箱</span></button>
      </div>
      <div class="closing-socials" aria-label="社交账号">
        {site.socials.map(social => <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label} title={social.label}><Icon name={social.icon} size={20} /></a>)}
        {site.resume && <a href={site.resume} target="_blank" rel="noopener noreferrer" aria-label="简历" title="简历"><Icon name="cv" size={20} /></a>}
      </div>
      <span class="closing-signature" aria-hidden="true">Kimura.</span>
    </div>
    <div class="closing-panel-meta"><span>MADE WITH CURIOSITY & CARE</span><span>{site.name} · PERSONAL ARCHIVE</span></div>
  </div>
  <div class="closing-portrait" aria-hidden="true"><span class="portrait-orbit"></span><img src={site.avatar} alt="" /></div>
  <div class="closing-bottom"><span>© {new Date().getFullYear()} {site.displayName}</span><a href="#top">BACK TO TOP ↑</a></div>
</section>
</main><div class="gallery-lightbox" id="gallery-lightbox" role="dialog" aria-modal="true" aria-label="影像查看器" aria-hidden="true" tabindex="-1" hidden>
  <div class="gallery-lightbox-backdrop" data-lightbox-close></div>
  <div class="gallery-lightbox-stage"><div class="gallery-lightbox-media" id="lightbox-media"></div><div class="gallery-lightbox-caption"><p id="lightbox-caption"></p><span id="lightbox-count"></span></div></div>
  <div class="gallery-lightbox-controls"><button type="button" id="lightbox-prev" aria-label="上一张">←</button><button type="button" id="lightbox-next" aria-label="下一张">→</button><button type="button" id="lightbox-close" data-lightbox-close aria-label="关闭影像">×</button></div>
</div><script src="/vendor/lenis.min.js" defer></script><script src="/interactions.js" defer></script><script src="/chapter-motion.js" defer></script></body></html>
