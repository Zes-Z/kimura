---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { siteConfig as site } from '../siteconfig';
import Icon from '../components/Icon.astro';
import { sitePath } from '../sitepath';
import photos from '../content/picture/photometa.json';

const pictureAssets = import.meta.glob('../content/picture/**/*.{svg,png,jpg,jpeg,webp,avif,gif,mp4,webm,mov}', {
  eager: true, query: '?url', import: 'default',
}) as Record<string, string>;
const pictureMetadata = import.meta.glob('../content/picture/**/*.{svg,png,jpg,jpeg,webp,avif,gif}', {
  eager: true, import: 'default',
}) as Record<string, ImageMetadata>;
function pictureSource(source: string): string {
  if (/^(https?:|data:|blob:)/.test(source)) return source;
  if (source.startsWith('/')) return sitePath(source);
  const key = `../content/picture/${source.replace(/^\.\//, '')}`;
  const url = pictureAssets[key];
  if (!url) throw new Error(`Missing picture asset: ${key}`);
  return url;
}
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const journeyPhotos = photos.filter(photo => photo.type === 'image').map(photo => {
  const key = `../content/picture/${photo.src.replace(/^\.\//, '')}`;
  const metadata = pictureMetadata[key];
  if (!metadata) throw new Error(`Missing journey image metadata: ${key}`);
  return { ...photo, source: pictureSource(photo.src), image: metadata, aspect: metadata.width / metadata.height };
});
const carouselCopies = Math.max(1, Math.ceil(8 / Math.max(1, journeyPhotos.length)));
const heroSource = pictureSource(site.heroMedia.src);
const heroPoster = site.heroMedia.poster ? pictureSource(site.heroMedia.poster) : undefined;
---
<html lang="zh-CN">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#edf1e9" />
  <meta name="description" content={`${site.displayName} 的个人博客：影像与随想。`} />
  <title>{site.displayName} — Personal archive</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href={sitePath('/style.css')} />
  <link rel="stylesheet" href={sitePath('/chapter-motion.css')} />
  <link rel="stylesheet" href={sitePath('/home-redesign.css')} />
  <script is:inline>
    if ((!location.hash || location.hash === '#top') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      try {
        if (!sessionStorage.getItem('kimura-intro-seen')) {
          sessionStorage.setItem('kimura-intro-seen', '1');
          document.documentElement.classList.add('hero-intro');
        }
      } catch {
        // A blocked storage preference leaves the hero in its readable state.
      }
    }
  </script>
</head>
<body>
  <div class="grain" aria-hidden="true"></div>
  <div class="floating-profile" id="floating-profile">
    <button class="floating-trigger" type="button" aria-label="打开个人链接" aria-expanded="false" aria-controls="floating-menu">
      <img src={sitePath(site.avatar)} alt="" />
      <span class="floating-name">{site.displayName}</span><span class="floating-plus" aria-hidden="true">+</span>
    </button>
    <div class="floating-menu" id="floating-menu" aria-hidden="true" inert>
      {site.socials.map(social => <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label} title={social.label}><Icon name={social.icon} size={19} /></a>)}
      <a href={`mailto:${site.email}`} aria-label="邮箱" title="邮箱"><Icon name="mailcolor" size={19} /></a>
      {site.resume && <a href={sitePath(site.resume)} target="_blank" rel="noopener noreferrer" aria-label="简历" title="简历"><Icon name="cv" size={19} /></a>}
    </div>
  </div>
  <main id="top">
    <section class="hero" style={`--hero-ratio:${site.heroImageRatio}`}>
      <div class="hero-art hero-media" style={`--hero-position:${site.heroMedia.objectPosition || 'center'}`}>
        {site.heroMedia.type === 'video'
          ? <video class="hero-media-object" src={heroSource} poster={heroPoster} aria-label={site.heroMedia.alt} autoplay muted loop playsinline preload="metadata"></video>
          : <img class="hero-media-object" src={heroSource} alt={site.heroMedia.alt} fetchpriority="high" decoding="async" />}
        <span class="hero-media-shade" aria-hidden="true"></span>
      </div>
      <div class="hero-avatar"><img src={sitePath(site.avatar)} alt={`${site.displayName} 的头像`} /></div>
      <div class="hero-info">
        <div class="intro-grid">
          <div>
            <p class="eyebrow">HELLO, I'M</p>
            <h1>{site.displayName}<span class="intro-period">.</span></h1>
            <p class="identity">{site.age} 岁 <span>·</span> {site.location} <span>·</span> <a href={site.siteUrl}>{site.domain} ↗</a></p>
          </div>
          <div class="intro-right">
            <p class="motto"><span class="motto-prefix">/</span><span id="typing" data-lines={JSON.stringify(site.motto)}>{site.motto[0]}</span><span class="cursor" aria-hidden="true"></span></p>
            <div class="hero-links">{site.socials.map(s => <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>)}<a href={`mailto:${site.email}`}>Email ↗</a>{site.resume && <a href={sitePath(site.resume)} target="_blank">Résumé ↗</a>}</div>
          </div>
        </div>
      </div>
    </section>

    <section class="section work-section" id="work">
      <header class="section-heading chapter-heading"><h2 class="section-number">01 / THE JOURNEY</h2></header>
      {journeyPhotos.length ? <div class="journey-carousel" id="journey-carousel" role="region" aria-roledescription="轮播" aria-label="旅途影像" data-perspective="3200" data-gap="60" data-curve="0">
        <div class="journey-viewport" id="journey-viewport" tabindex="0" aria-label="拖动或使用左右方向键浏览影像">
          <div class="journey-stage"><div class="journey-camera" id="journey-camera"><div class="journey-ring" id="journey-ring">
            {Array.from({ length: carouselCopies }, (_, copy) => journeyPhotos.map((photo, index) => {
              const aspect = Math.min(1.8, Math.max(.6, photo.aspect));
              const title = photo.caption.replace(/^\d+\s*\/\s*/, '');
              return <div class="journey-card" data-index={index} data-copy={copy} style={`--card-ratio:${aspect.toFixed(4)}`} aria-hidden={copy === 0 && index === 0 ? undefined : 'true'}>
                <button class="journey-tile" type="button" aria-label={`查看影像：${photo.alt}`} data-src={photo.source} data-alt={photo.alt} data-caption={title} tabindex={copy === 0 && index === 0 ? 0 : -1}>
                  <span class="journey-image"><Image src={photo.image} alt="" draggable="false" loading={copy === 0 && index < 4 ? 'eager' : 'lazy'} /></span>
                </button>
              </div>;
            }))}
          </div></div></div>
        </div>
      </div> : <p class="archive-empty">影像即将更新。</p>}
    </section>

    <section class="section notes-section" data-chapter="notes" id="notes">
      <header class="section-heading chapter-heading"><h2 class="section-number">02 / MARGIN NOTES</h2></header>
      {posts.length ? <div class="ticket-grid" aria-label="随想文章">
        {posts.map((post, index) => <article class="tear-ticket" style={`--ticket-rotate:${index % 3 === 0 ? '-3deg' : index % 3 === 1 ? '2deg' : '-1deg'}`}>
          <div class="tear-ticket-plane">
            <a class="tear-ticket-body" href={sitePath(`/post/${post.id}/`)} aria-label={`阅读随想：${post.data.title}`}>
              <Image src={post.data.cover} alt="" loading="lazy" draggable="false" />
              <span class="tear-ticket-scrim" aria-hidden="true"></span>
              <span class="tear-ticket-copy"><small>{post.data.label || 'FIELD NOTE'}</small><strong>{post.data.title}</strong><time datetime={post.data.date.toISOString().slice(0, 10)}>{post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}</time><span>{post.data.description}</span></span>
            </a>
            <span class="tear-ticket-fibres" aria-hidden="true">{Array.from({ length: 9 }, () => <i></i>)}</span>
            <button class="tear-ticket-stub" type="button" aria-label={`撕下「${post.data.title}」的票根`}><span class="tear-ticket-stub-top">KIMURA<br />ARCHIVE</span><span class="tear-ticket-stub-index">{String(index + 1).padStart(3, '0')}</span><span class="tear-ticket-stub-bottom">TEAR<br />HERE <b aria-hidden="true">↗</b></span></button>
          </div>
        </article>)}
      </div> : <p class="archive-empty">随想即将更新。</p>}
    </section>

    <section class="closing" id="about" data-chapter="about">
      <div class="closing-panel">
        <p class="closing-kicker">03 / BEYOND THE PAGE</p>
        <div class="closing-content">
          <h2><span class="chapter-line"><span>想说的话，</span></span><span class="chapter-line"><em>都欢迎。</em></span></h2>
          <p>分享一个想法，或只是打声招呼。<br />下一段故事，就从这里开始。</p>
          <div class="closing-actions">
            <a class="contact-link" href={`mailto:${site.email}`}>写封邮件 <span aria-hidden="true">↗</span></a>
            <button class="copy-email" type="button" data-copy-email={site.email} aria-label="复制邮箱地址"><Icon name="mail" size={18} /><span class="copy-label" aria-live="polite">复制邮箱</span></button>
          </div>
          <div class="closing-socials" aria-label="社交账号">
            {site.socials.map(social => <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label} title={social.label}><Icon name={social.icon} size={20} /></a>)}
            {site.resume && <a href={sitePath(site.resume)} target="_blank" rel="noopener noreferrer" aria-label="简历" title="简历"><Icon name="cv" size={20} /></a>}
          </div>
          <span class="closing-signature" aria-hidden="true">Kimura.</span>
        </div>
        <div class="closing-panel-meta"><span>MADE WITH CURIOSITY & CARE</span><span>{site.name} · PERSONAL ARCHIVE</span></div>
      </div>
      <div class="closing-portrait" aria-hidden="true"><span class="portrait-orbit"></span><img src={sitePath(site.avatar)} alt="" /></div>
      <div class="closing-bottom"><span>© {new Date().getFullYear()} {site.displayName}</span><a href="#top">BACK TO TOP ↑</a></div>
    </section>
  </main>
  <dialog class="journey-lightbox" id="journey-lightbox" aria-label="影像查看器">
    <div class="journey-lightbox-top"><span>01 / THE JOURNEY</span><button type="button" data-lightbox-close aria-label="关闭影像">×</button></div>
    <div class="journey-lightbox-media"><img id="journey-lightbox-image" alt="" /></div>
    <div class="journey-lightbox-bottom"><button type="button" data-lightbox-prev aria-label="上一张影像">←</button><div><strong id="journey-lightbox-caption"></strong><span id="journey-lightbox-count"></span></div><button type="button" data-lightbox-next aria-label="下一张影像">→</button></div>
  </dialog>
  <script src={sitePath('/vendor/lenis.min.js')} defer></script>
  <script src={sitePath('/interactions.js')} defer></script>
  <script src={sitePath('/journey-carousel.js')} defer></script>
  <script src={sitePath('/tear-tickets.js')} defer></script>
  <script src={sitePath('/chapter-motion.js')} defer></script>
</body>
</html>
